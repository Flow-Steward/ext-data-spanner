@@ -0,0 +1,54 @@
+// Copyright 2026 Flow Steward. Licensed under Apache-2.0.
+package clickhouse
+
+import (
+	"context"
+	"database/sql"
+	"database/sql/driver"
+	"fmt"
+	"testing"
+)
+
+type fsWriteDriver struct{}
+type fsWriteConn struct{}
+
+var fsCalls int
+var fsSQL string
+var fsArgs []driver.NamedValue
+var fsFail bool
+
+func (fsWriteDriver) Open(string) (driver.Conn, error)  { return fsWriteConn{}, nil }
+func (fsWriteConn) Prepare(string) (driver.Stmt, error) { return nil, fmt.Errorf("unexpected prepare") }
+func (fsWriteConn) Close() error                        { return nil }
+func (fsWriteConn) Begin() (driver.Tx, error)           { return nil, fmt.Errorf("unexpected transaction") }
+func (fsWriteConn) ExecContext(_ context.Context, query string, args []driver.NamedValue) (driver.Result, error) {
+	fsCalls++
+	fsSQL = query
+	fsArgs = args
+	if fsFail {
+		return nil, driver.ErrBadConn
+	}
+	return driver.RowsAffected(1), nil
+}
+func init() { sql.Register("flowsteward-write-clickhouse", fsWriteDriver{}) }
+func TestFlowStewardBoundWrite(t *testing.T) {
+	db, err := sql.Open("flowsteward-write-clickhouse", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	source := Source{Pool: db}
+	for _, fail := range []bool{false, true} {
+		fsCalls = 0
+		fsFail = fail
+		query := "UPDATE products SET name = ? WHERE id = ?"
+		value := "x'; DELETE FROM products --"
+		_, err := source.RunWrite(context.Background(), query, []any{value, int64(5)})
+		if (err != nil) != fail {
+			t.Fatalf("error=%v fail=%v", err, fail)
+		}
+		if fsCalls != 1 || fsSQL != query || len(fsArgs) != 2 || fsArgs[0].Value != value || fsArgs[1].Value != int64(5) {
+			t.Fatalf("write lost binding or retried: %d %q %#v", fsCalls, fsSQL, fsArgs)
+		}
+	}
+}
