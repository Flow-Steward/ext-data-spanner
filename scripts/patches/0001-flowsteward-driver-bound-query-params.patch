@@ -0,0 +1,42 @@
+package sqlite
+
+import (
+	"context"
+	"database/sql"
+	"path/filepath"
+	"testing"
+)
+
+func TestFlowStewardBoundWriteSQLiteLifecycle(t *testing.T) {
+	db, err := sql.Open("sqlite", filepath.Join(t.TempDir(), "orders.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if _, err = db.Exec("CREATE TABLE products(id INTEGER PRIMARY KEY, name TEXT)"); err != nil {
+		t.Fatal(err)
+	}
+	source := Source{Db: db}
+	ctx := context.Background()
+	value := "O'Reilly; DELETE FROM products --"
+	if _, err = source.RunWrite(ctx, "INSERT INTO products(id,name) VALUES (?,?)", []any{int64(1), value}); err != nil {
+		t.Fatal(err)
+	}
+	var got string
+	if err = db.QueryRow("SELECT name FROM products WHERE id=?", 1).Scan(&got); err != nil || got != value {
+		t.Fatalf("bound insert: %q %v", got, err)
+	}
+	if _, err = source.RunWrite(ctx, "UPDATE products SET name=? WHERE id=?", []any{"updated", int64(1)}); err != nil {
+		t.Fatal(err)
+	}
+	if err = db.QueryRow("SELECT name FROM products WHERE id=?", 1).Scan(&got); err != nil || got != "updated" {
+		t.Fatalf("bound update: %q %v", got, err)
+	}
+	if _, err = source.RunWrite(ctx, "DELETE FROM products WHERE id=?", []any{int64(1)}); err != nil {
+		t.Fatal(err)
+	}
+	var count int
+	if err = db.QueryRow("SELECT COUNT(*) FROM products").Scan(&count); err != nil || count != 0 {
+		t.Fatalf("bound delete: %d %v", count, err)
+	}
+}
