new file mode 100644
index 0000000000..61eab7e90d
--- /dev/null
+++ b/internal/util/flowstewardbinding/binding_test.go
@@ -0,0 +1,98 @@
+// Copyright 2026 Flow Steward
+// Licensed under the Apache License, Version 2.0.
+
+package flowstewardbinding
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/googleapis/mcp-toolbox/internal/util/parameters"
+)
+
+func TestBoundQueryPreservesLargeInteger(t *testing.T) {
+	query, err := Parse(parameters.ParamValues{
+		{Name: "sql", Value: "SELECT id FROM events WHERE id = $1"},
+		{Name: "params_json", Value: `{"id":9007199254740993}`},
+		{Name: "param_order", Value: []any{"id"}},
+		{Name: "binding", Value: BindingNumbered},
+	})
+	if err != nil {
+		t.Fatalf("Parse() error = %v", err)
+	}
+	values, err := query.Positional()
+	if err != nil {
+		t.Fatalf("Positional() error = %v", err)
+	}
+	if got, ok := values[0].(int64); !ok || got != 9007199254740993 {
+		t.Fatalf("large integer lost precision: %#v", values[0])
+	}
+	if _, ok := query.Values["id"].(json.Number); ok {
+		t.Fatal("large integer was not converted for the database driver")
+	}
+}
+
+func TestBoundValuesRemainSeparateAndRepeated(t *testing.T) {
+	query, err := Parse(parameters.ParamValues{
+		{Name: "sql", Value: "SELECT * FROM events WHERE event = $1 OR parent = $2"},
+		{Name: "params_json", Value: `{"event":"x' OR 1=1 --"}`},
+		{Name: "param_order", Value: []any{"event", "event"}},
+		{Name: "binding", Value: BindingNumbered},
+	})
+	if err != nil {
+		t.Fatalf("Parse() error = %v", err)
+	}
+	values, err := query.Positional()
+	if err != nil {
+		t.Fatalf("Positional() error = %v", err)
+	}
+	if query.SQL != "SELECT * FROM events WHERE event = $1 OR parent = $2" {
+		t.Fatalf("SQL was modified with a runtime value: %q", query.SQL)
+	}
+	if len(values) != 2 || values[0] != "x' OR 1=1 --" || values[1] != values[0] {
+		t.Fatalf("unexpected positional values: %#v", values)
+	}
+}
+
+func TestNumberedMapPreservesOccurrenceOrder(t *testing.T) {
+	query := BoundQuery{
+		Values:     map[string]any{"event": "open"},
+		ParamOrder: []string{"event", "event"},
+		Binding:    BindingNumberedMap,
+	}
+	values, err := query.NumberedMap()
+	if err != nil {
+		t.Fatalf("NumberedMap() error = %v", err)
+	}
+	if values["p1"] != "open" || values["p2"] != "open" {
+		t.Fatalf("unexpected numbered map: %#v", values)
+	}
+}
+
+func TestParseRejectsUnknownOrderEntry(t *testing.T) {
+	_, err := Parse(parameters.ParamValues{
+		{Name: "sql", Value: "SELECT ?"},
+		{Name: "params_json", Value: `{}`},
+		{Name: "param_order", Value: []any{"missing"}},
+		{Name: "binding", Value: BindingPositional},
+	})
+	if err == nil {
+		t.Fatal("Parse() unexpectedly accepted an unknown parameter")
+	}
+}
+
+func TestWriteBindingIsExplicitAndKeepsValuesSeparate(t *testing.T) {
+	q, err := Parse(parameters.ParamValues{
+		{Name: "sql", Value: "DELETE FROM products WHERE id = ?"},
+		{Name: "params_json", Value: `{"id":"x'; DROP TABLE products --"}`},
+		{Name: "param_order", Value: []any{"id"}},
+		{Name: "binding", Value: "write-positional"},
+	})
+	if err != nil || !q.Write || q.Binding != BindingPositional {
+		t.Fatalf("write binding rejected: %#v %v", q, err)
+	}
+	args, err := q.Positional()
+	if err != nil || len(args) != 1 || args[0] != "x'; DROP TABLE products --" || q.SQL != "DELETE FROM products WHERE id = ?" {
+		t.Fatalf("write binding modified values: %#v %v", q, err)
+	}
+}
