+// Copyright 2026 Flow Steward
+// Licensed under the Apache License, Version 2.0.
+package clickhouse
+
+import (
+	"context"
+	"github.com/googleapis/mcp-toolbox/internal/sources"
+	"github.com/googleapis/mcp-toolbox/internal/testutils"
+	"github.com/googleapis/mcp-toolbox/internal/tools"
+	"github.com/googleapis/mcp-toolbox/internal/util/parameters"
+	"reflect"
+	"testing"
+)
+
+type flowStewardSource struct {
+	sources.Source
+	sql    string
+	values parameters.ParamValues
+	calls  int
+}
+
+func (s *flowStewardSource) RunSQL(ctx context.Context, statement string, values parameters.ParamValues) (any, error) {
+	s.sql = statement
+	s.values = values
+	s.calls++
+	return "ok", nil
+}
+func TestFlowStewardInvokeBoundValues(t *testing.T) {
+	ctx, err := testutils.ContextWithNewLogger()
+	if err != nil {
