+	params := parameters.ParamValues{{Name: "sql", Value: "SELECT $1, $2"}, {Name: "params_json", Value: `{"event":"x' OR 1=1 --"}`}, {Name: "param_order", Value: []any{"event", "event"}}, {Name: "binding", Value: "positional"}}
+	source := &flowStewardSource{}
+	if _, err := tool.Invoke(ctx, source, params, tools.AccessToken("")); err != nil {
+		t.Fatal(err)
+	}
+	want := []any{value, value}
+	if source.sql != "SELECT $1, $2" || !reflect.DeepEqual(source.values, want) {
+		t.Fatalf("driver received SQL=%q values=%#v; want separated bound values %#v", source.sql, source.values, want)
+	}
+	params[3].Value = "unsupported"
+	if _, err := tool.Invoke(ctx, source, params, tools.AccessToken("")); err == nil {
+		t.Fatal("invalid binding reached driver")
+	}
+	if source.calls != 1 {
+		t.Fatalf("driver invoked %d times", source.calls)
+	}
+}
+
+func (s *flowStewardSource) RunWrite(ctx context.Context, statement string, values []any) (any, error) {
+	s.sql = statement
+	s.calls += 100
+	s.values = values
+	return "ok", nil
+}
+
+func TestFlowStewardInvokeWriteDispatch(t *testing.T) {
+	ctx, err := testutils.ContextWithNewLogger()
+	if err != nil {
+		t.Fatal(err)
+	}
+	tool, err := (Config{ConfigBase: tools.ConfigBase{Name: "bound", Description: "test"}}).Initialize(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	value := "x' OR 1=1 --"
+	params := parameters.ParamValues{{Name: "sql", Value: "UPDATE events SET event=$1 WHERE parent=$2"}, {Name: "params_json", Value: `{"event":"x' OR 1=1 --"}`}, {Name: "param_order", Value: []any{"event", "event"}}, {Name: "binding", Value: "write-positional"}}
+	source := &flowStewardSource{}
+	if _, err := tool.Invoke(ctx, source, params, tools.AccessToken("")); err != nil {
+		t.Fatal(err)
+	}
+	want := []any{value, value}
+	if !reflect.DeepEqual(source.values, want) {
+		t.Fatalf("write lost bound values: %#v", source.values)
+	}
+	if source.calls != 100 || source.sql != "UPDATE events SET event=$1 WHERE parent=$2" {
+		t.Fatalf("write did not use once-only driver: calls=%d SQL=%q", source.calls, source.sql)
+	}
+}
