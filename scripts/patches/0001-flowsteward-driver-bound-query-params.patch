diff --git a/internal/sources/spanner/spanner.go b/internal/sources/spanner/spanner.go
index a09a18734d..61ad52de1e 100644
--- a/internal/sources/spanner/spanner.go
+++ b/internal/sources/spanner/spanner.go
@@ -318,3 +318,20 @@ func (s *Source) InvokeSearchCatalog(ctx context.Context, params map[string]any,
 		},
 	)
 }
+
+// RunWrite uses a statement transaction with explicit commit and no retry loop.
+func (s *Source) RunWrite(ctx context.Context, statement string, params map[string]any) (any, error) {
+	txn, err := spanner.NewReadWriteStmtBasedTransaction(ctx, s.SpannerClient())
+	if err != nil {
+		return nil, err
+	}
+	defer txn.Rollback(ctx)
+	affected, err := txn.Update(ctx, spanner.Statement{SQL: statement, Params: params})
+	if err != nil {
+		return nil, err
+	}
+	if _, err := txn.Commit(ctx); err != nil {
+		return nil, err
+	}
+	return []any{map[string]any{"affected_rows": affected}}, nil
+}
